@{
    ViewData["Title"] = "User details";
}

<section id="user-details-page"
         class="page page--narrow"
         aria-labelledby="details-title">

    <header class="page-head">
        <a class="back" href="/Users">Back to users</a>
        <h1 id="details-title" data-bind="text: title">User details</h1>
    </header>

    <div class="alert alert--error"
         role="alert"
         style="display:none"
         data-bind="visible: error, text: error">
    </div>

    <p class="status-line"
       role="status"
       style="display:none"
       data-bind="visible: loading">
        Loading user…
    </p>

    <form class="panel form"
          novalidate
          style="display:none"
          data-bind="visible: !loading(), submit: save">

        <div class="alert alert--error"
             role="alert"
             style="display:none"
             data-bind="visible: !isView() && errors().length">
            Fix the highlighted fields and try again.
        </div>

        <div class="grid2">

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('userName') }">

                <span class="field-label">User name</span>

                <span data-bind="text: model.userName"></span>

                <input type="text"
                       maxlength="50"
                       autocomplete="off"
                       data-bind="textInput: model.userName" />

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('userName')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('email') }">

                <span class="field-label">Email</span>

                <span data-bind="text: model.email"></span>

                <input type="email"
                       maxlength="50"
                       autocomplete="off"
                       data-bind="textInput: model.email" />

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('email')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': errorFor('password') }">

                <span class="field-label">Password</span>

                <input type="password"
                       maxlength="50"
                       autocomplete="new-password"
                       data-bind="textInput: model.password" />

                <span class="field-hint" data-bind="visible: isEdit">
                    Leave empty to keep the current password.
                </span>

                <span class="field-error"
                      data-bind="text: errorFor('password')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('roleTypePK') }">

                <span class="field-label">Role</span>

                <span data-bind="text: roleName"></span>

                <select data-bind="
                    options: roles,
                    optionsText: 'name',
                    optionsValue: 'id',
                    value: model.roleTypePK,
                    optionsCaption: 'Choose a role'">
                </select>

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('roleTypePK')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('firstName') }">

                <span class="field-label">First name</span>

                <span data-bind="text: model.firstName"></span>

                <input type="text"
                       maxlength="50"
                       data-bind="textInput: model.firstName" />

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('firstName')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('secondName') }">

                <span class="field-label">Second name (optional)</span>

                <span data-bind="text: model.secondName() || '—'"></span>

                <input type="text"
                       maxlength="50"
                       data-bind="textInput: model.secondName" />

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('secondName')">
                </span>
            </label>

            <label class="field"
                   data-bind="css: { 'field--invalid': !isView() && errorFor('birthDate') }">

                <span class="field-label">Birth date (optional)</span>

                <span data-bind="text: birthDateText() || '—'"></span>

                <input type="date"
                       data-bind="value: model.birthDate" />

                <span class="field-error"
                      data-bind="visible: !isView(), text: errorFor('birthDate')">
                </span>
            </label>

            <div class="field">
                <span class="field-label">Status</span>

                <span class="chip"
                      data-bind="
                          css: {
                              'chip--on': model.activeStatus(),
                              'chip--off': !model.activeStatus()
                          },
                          text: model.activeStatus() ? 'Active' : 'Inactive'">
                </span>

                <label class="check check--box">
                    <input type="checkbox"
                           data-bind="checked: model.activeStatus" />
                    Active user
                </label>
            </div>

        </div>

        <div class="actions">

            <button type="button"
                    class="btn btn--primary"
                    data-bind="click: goEdit">
                Edit user
            </button>

            <button type="button"
                    class="btn btn--danger"
                    data-bind="click: remove, disable: saving">
                Delete user
            </button>

            <button type="submit"
                    class="btn btn--primary"
                    data-bind="
                        disable: saving,
                        text: isAdd() ? 'Create user' : 'Save changes'">
            </button>

            <button type="button"
                    class="btn"
                    data-bind="click: cancel, disable: saving">
                Cancel
            </button>

            <span class="status-line"
                  role="status"
                  style="display:none"
                  data-bind="visible: saving">
                Saving…
            </span>

        </div>
    </form>
</section>

@section Scripts {
    <script>
        require(['app/user_details']);
    </script>
}
